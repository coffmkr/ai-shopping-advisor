# Variables del proyecto. Copia este archivo a .env (está en .gitignore) y completa los valores.
# Nunca subas claves reales al repositorio.

# --- Amazon Afiliados (no es secreto) ---
AMAZON_TAG=zapyens-20

# --- Canopy (datos de amazon.com por MCP) ---
# Obligatoria para grabar los productos de la semilla (T1) y para el agente (T5).
# Plan gratuito: 100 requests/mes. Grabar la semilla usa unas 30.
CANOPY_API_KEY=
CANOPY_MCP_URL=https://mcp.canopyapi.co/mcp
CANOPY_MAX_SEARCHES_PER_DAY=5

# --- Claude API (lo usa el agente buscador para redactar las fichas) ---
# Opcional: solo para que el agente redacte fichas nuevas en vivo (T5).
# Sin ella, el agente usa respuestas grabadas. Se obtiene en console.anthropic.com (facturación aparte de Claude Code).
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5-5

# --- Administrador de prueba que crea la semilla (solo desarrollo local) ---
ADMIN_EMAIL=admin@ai-shopping-advisor.test
ADMIN_PASSWORD=demo-local-2026

# --- Base de datos (Docker Compose, solo desarrollo local) ---
DB_HOST=127.0.0.1
DB_PORT=55432
DB_USER=advisor
DB_PASSWORD=advisor
DB_DATABASE=advisor_dev
DB_TEST_DATABASE=advisor_test
